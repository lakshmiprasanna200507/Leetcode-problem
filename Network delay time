import heapq

class Solution:
    def networkDelayTime(self, times, n, k):
        graph = {}

        for u, v, w in times:
            if u not in graph:
                graph[u] = []
            graph[u].append((v, w))
        pq = [(0, k)]
        distance = {}

        while pq:
            time, node = heapq.heappop(pq)

            if node in distance:
                continue

            distance[node] = time
            for next_node, weight in graph.get(node, []):
                if next_node not in distance:
                    heapq.heappush(
                        pq,
                        (time + weight, next_node)
                    )
        if len(distance) != n:
            return -1

        return max(distance.values())
